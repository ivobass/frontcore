// ====================================================================
// FrontCore — schema partilhado (core multi-tenant + domínio FrontRest)
// --------------------------------------------------------------------
// Secção CORE: modelos reutilizáveis por qualquer produto SaaS —
// Organization (tenant), User, Membership (RBAC), RefreshToken,
// HealthCheck. Zero lógica de domínio.
//
// Secção FRONTREST (a partir daqui, ver marcador abaixo): modelos de
// domínio do produto FrontRest (Fase 4+), todos com organizationId.
// Vivem neste mesmo ficheiro porque o monorepo gera um único Prisma
// Client sobre uma única base de dados — não porque packages/database
// deixou de ser genérico. Um segundo produto (FrontClinic, ...) com
// modelos próprios repete o mesmo padrão numa secção equivalente, sem
// partilhar tabelas de domínio com o FrontRest.
// ====================================================================

generator client {
  provider      = "prisma-client-js"
  // Output customizado: gera o Client como ficheiros reais dentro do próprio
  // package (não em node_modules/.prisma). Isto é o que torna o Client
  // imune a "pnpm deploy" — que materializa node_modules de novo a partir do
  // lockfile e NÃO preserva efeitos de "prisma generate" corridos numa árvore
  // node_modules diferente. Ao viver em src/, o Client é copiado para dist/
  // como qualquer outro ficheiro do package, e é isso que chega a produção.
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Papéis genéricos de acesso dentro de uma organização (RBAC base).
enum Role {
  OWNER
  ADMIN
  MANAGER
  MEMBER
}

/// Tenant. Unidade de isolamento multi-tenant para qualquer produto.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships        Membership[]
  suppliers          Supplier[]
  expenseCategories  ExpenseCategory[]
  invoices           Invoice[]
  storageObjects     StorageObject[]
  invoiceAttachments InvoiceAttachment[]
  invoiceDrafts      InvoiceDraft[]

  @@index([slug])
}

/// Utilizador da plataforma. Pode pertencer a várias organizações.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships   Membership[]
  refreshTokens RefreshToken[]

  @@index([email])
}

/// Ligação utilizador<->organização com papel. Base do RBAC multi-tenant.
model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

/// Tabela mínima para validar que as migrações correm ponta a ponta.
model HealthCheck {
  id        String   @id @default(cuid())
  status    String   @default("ok")
  createdAt DateTime @default(now())
}

/// Refresh token opaco (valor guardado apenas como hash). Permite rotação
/// e revogação imediata. Genérico — qualquer produto FrontCore o reutiliza.
model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ====================================================================
// FRONTREST — domínio de fornecedores e despesas (Fase 4)
// ====================================================================

/// Fornecedor de uma organização. Domínio FrontRest.
model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  email          String?
  phone          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  invoiceDrafts InvoiceDraft[]

  @@index([organizationId])
}

/// Categoria de despesa de uma organização. Domínio FrontRest.
model ExpenseCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  invoiceDrafts InvoiceDraft[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

/// Fatura de despesa associada a um fornecedor. Domínio FrontRest.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  supplierId     String
  categoryId     String?
  number         String?
  issueDate      DateTime
  dueDate        DateTime?
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category     ExpenseCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  attachments  InvoiceAttachment[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([categoryId])
}

/// Linha de item de uma fatura. Domínio FrontRest.
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

/// Objeto genérico armazenado em storage de objetos (S3/MinIO). Sem
/// lógica de domínio — módulos consumidores (Invoice, Avatar, Report,
/// OCR, ...) referenciam StorageObject.id, nunca `key` diretamente.
/// `key` é nula até o objeto ser efetivamente guardado em storage;
/// leituras públicas devem sempre filtrar `key: { not: null }`.
model StorageObject {
  id             String   @id @default(cuid())
  organizationId String
  key            String?  @unique
  filename       String
  contentType    String
  size           Int
  createdAt      DateTime @default(now())

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  attachment   InvoiceAttachment?
  draft        InvoiceDraft?

  @@index([organizationId])
}

/// Liga uma fatura a um StorageObject já existente — StorageObject
/// continua genérico, sem conhecimento de Invoice; toda a lógica de
/// domínio fica aqui. Domínio FrontRest.
model InvoiceAttachment {
  id              String   @id @default(cuid())
  organizationId  String
  invoiceId       String
  storageObjectId String   @unique
  createdAt       DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  storageObject StorageObject @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([invoiceId])
}

/// Estado do processamento OCR de um InvoiceDraft (Fase 6.5). Não é o
/// estado do InvoiceDraft em si (que continua a ser "existe = rascunho",
/// ver comentário do modelo) — é só o ciclo de vida do job OCR associado.
/// PENDING cobre tanto "ainda não tentado" como "falha temporária,
/// aguarda o próximo retry automático do BullMQ" — o retry em si nunca
/// fica visível como estado próprio, é uma condição transitória entre
/// tentativas, não um estado em repouso.
enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

/// Rascunho de fatura originado por upload/OCR — área de staging antes de
/// existir uma Invoice real. Entidade deliberadamente separada de Invoice
/// (Fase 6.3): Invoice continua a representar sempre um documento
/// financeiro válido e completo (supplierId/issueDate/totalAmount
/// obrigatórios, sem alteração nesta fase); um InvoiceDraft pode existir
/// com qualquer subconjunto desses campos em falta, refletindo o estado
/// real de um documento ainda por confirmar. A existência da linha já
/// representa o estado "em rascunho" — sem enum de estado próprio.
/// Promovido explicitamente a Invoice + InvoiceAttachment (ver
/// InvoiceDraftsService.promote()). Desde a Fase 6.4, o Worker OCR
/// (OcrProcessingProcessor) lê e escreve `ocrText`/`ocrConfidence` numa
/// linha existente após um job publicado por InvoiceDraftsService.create()
/// — nunca cria, elimina ou promove um InvoiceDraft; essas operações
/// continuam exclusivas da API. Desde a Fase 6.5, o mesmo Worker também
/// mantém `ocrStatus`/`ocrError` ao longo de tentativas automáticas com
/// backoff exponencial (ver `docs/phases/phase-6.5-ocr-retry-recovery-foundation.md`).
model InvoiceDraft {
  id              String    @id @default(cuid())
  organizationId  String
  storageObjectId String    @unique
  supplierId      String?
  categoryId      String?
  number          String?
  issueDate       DateTime?
  dueDate         DateTime?
  totalAmount     Decimal?  @db.Decimal(12, 2)
  notes           String?
  /// Texto bruto extraído por OCR (Fase 6.2) — área de staging; nunca
  /// persistido no Invoice final (ver "Regras de domínio", ponto 12).
  ocrText         String?
  ocrConfidence   Float?
  /// Ciclo de vida do processamento OCR (Fase 6.5) — ver enum OcrStatus.
  ocrStatus       OcrStatus @default(PENDING)
  /// Mensagem sanitizada da última falha permanente (ocrStatus FAILED) —
  /// nunca a mensagem bruta da exceção (evita expor detalhes internos de
  /// storage/Redis/provider através de GET /invoices/drafts). Detalhe
  /// técnico completo só nos logs do Worker.
  ocrError        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  storageObject StorageObject    @relation(fields: [storageObjectId], references: [id], onDelete: Restrict)
  supplier      Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([supplierId])
  @@index([categoryId])
}
