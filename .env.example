# ====================================================================
# FrontCore — variáveis de ambiente (Fase 1)
# Copia para .env e ajusta. NUNCA versionar o .env real.
# ====================================================================

# ---------- Node ----------
NODE_ENV=development

# ---------- Produto ativo ----------
# Identifica o produto construído sobre o FrontCore (genérico vê isto como label).
PRODUCT_NAME=frontrest

# ---------- PostgreSQL ----------
POSTGRES_USER=frontcore
POSTGRES_PASSWORD=frontcore_local_pw
POSTGRES_DB=frontcore
# URL usado por ferramentas no HOST (prisma migrate/studio a partir do Mac).
# Dentro do Docker a API constrói o seu próprio URL (host "postgres") com connection_limit.
DATABASE_URL=postgresql://frontcore:frontcore_local_pw@localhost:5432/frontcore?schema=public

# ---------- Redis ----------
# URL para uso no HOST. Dentro do Docker usa-se redis://redis:6379.
REDIS_URL=redis://localhost:6379

# ---------- MinIO / S3 ----------
MINIO_ROOT_USER=frontcore_minio
MINIO_ROOT_PASSWORD=frontcore_minio_pw
S3_BUCKET=frontcore
# Endpoint usado pela API para falar com o storage (put/get/delete).
# Dentro do docker-compose, a API usa sempre "http://minio:9000" (definido
# diretamente no serviço "api", não lido daqui) — este valor serve para
# ferramentas correndo no HOST (fora do Docker).
S3_ENDPOINT=http://localhost:9000
# Endpoint embutido nos URLs assinados devolvidos ao browser — tem de ser
# resolúvel a partir de fora do Docker. Em local, a porta do MinIO já está
# publicada no host (ver docker-compose.yml), por isso é sempre localhost.
# Em produção: o domínio público real do storage (ver docs/DEPLOY-COOLIFY.md).
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---------- API ----------
PORT=3001

# ---------- Reverse proxy / Cloudflare ----------
# 0 em local (sem proxy). Produção atrás de Cloudflare + Traefik = 2.
TRUST_PROXY_HOPS=0
# Origens permitidas para CORS (separadas por vírgula).
CORS_ORIGINS=http://localhost:3000

# ---------- Web ----------
# Lido pelo browser. É "inlined" no bundle do Next em BUILD TIME.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ---------- Cookies (consumidos a partir da Fase 2) ----------
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ---------- Auth (placeholders — implementação real na Fase 2) ----------
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ---------- IA (Fase 6.11 — @frontcore/ai) ----------
# "mock" (omissão) não exige AI_MODEL nem nenhuma credencial — determinístico, sem I/O.
# Sem consumidor real ainda (nenhum extractor de IA implementado) — ver
# docs/phases/phase-6.11-ai-provider-foundation.md.
AI_PROVIDER=mock
# Obrigatório só quando AI_PROVIDER=ollama — sem default permanente (ver createAiProvider()).
# Confirmar com "ollama list" que o modelo está descarregado localmente.
AI_MODEL=qwen3:4b
# Endpoint HTTP local do Ollama — API nativa (/api/chat), nunca o
# endpoint OpenAI-compatible. Sem AI_API_KEY: Ollama corre localmente,
# sem fronteira de rede pública a autenticar.
AI_BASE_URL=http://localhost:11434
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024

# ---------- OCR (Fase 6.2) ----------
# Motor selecionado por apps/frontrest/workers via @frontcore/ocr.
# "tesseract" é o único implementado nesta fase; ver createOcrProvider().
OCR_PROVIDER=tesseract
# "por" — faturas reais são em português (nomes/moradas com acentos e
# cedilha); confirmado que "eng" perde caracteres como "Ç" (ver
# packages/ocr/src/contracts/ocr-config.ts).
OCR_LANGUAGE=por
OCR_TIMEOUT_MS=30000

# ---------- Rasterização PDF (Fase 6.9) ----------
# Limites aplicados por PopplerPdfRasterizer antes de qualquer PDF chegar
# ao Tesseract — ver docs/phases/phase-6.9-pdf-rasterization-foundation.md.
OCR_PDF_MAX_PAGES=10
OCR_PDF_DPI=200
OCR_PDF_MAX_DIMENSION_PX=2500
OCR_PDF_RASTER_TIMEOUT_MS=30000
