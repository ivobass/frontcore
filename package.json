{
  "name": "frontcore",
  "version": "0.1.0",
  "private": true,
  "description": "FrontCore — base SaaS reutilizável da FrontWeb (domain-agnostic).",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "docs:validate": "node scripts/validate-docs.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @frontcore/database prisma:generate",
    "db:build": "pnpm --filter @frontcore/database... build",
    "db:migrate": "pnpm --filter @frontcore/database prisma:migrate",
    "db:deploy": "pnpm --filter @frontcore/database prisma:deploy",
    "db:seed": "pnpm --filter @frontcore/database db:seed",
    "db:studio": "pnpm --filter @frontcore/database prisma:studio",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.1.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
