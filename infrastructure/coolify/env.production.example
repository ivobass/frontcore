# Exemplo de variáveis para o Coolify (produção). NÃO commitar valores reais.
NODE_ENV=production
PRODUCT_NAME=frontrest

# Postgres (geridos como secrets no Coolify)
POSTGRES_USER=frontcore
POSTGRES_PASSWORD=__set_in_coolify__
POSTGRES_DB=frontcore

# Redis
REDIS_URL=redis://redis:6379

# MinIO / S3
MINIO_ROOT_USER=__set_in_coolify__
MINIO_ROOT_PASSWORD=__set_in_coolify__
S3_BUCKET=frontcore
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Reverse proxy / Cloudflare
TRUST_PROXY_HOPS=2
CORS_ORIGINS=https://app.dominio.pt

# URLs públicas
NEXT_PUBLIC_API_URL=https://api.dominio.pt/api
APP_URL=https://app.dominio.pt
API_URL=https://api.dominio.pt

# Cookies
COOKIE_DOMAIN=.dominio.pt
COOKIE_SECURE=true

# Auth (secrets no Coolify)
JWT_ACCESS_SECRET=__set_in_coolify__
JWT_REFRESH_SECRET=__set_in_coolify__
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# IA
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=__set_in_coolify__
